# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/avi_db
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/avi_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/avi_db

# Auth
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Password assigned to seeded demo accounts by `npm run seed`
SEED_DEMO_PASSWORD=vikas123
